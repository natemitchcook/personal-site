# @steered SNARE-2 2026-09-29

# Non-secret local configuration. Provider credentials belong in the protected
# file configured below, never in this environment file.
RUFFI_AWARD_PROVIDER=seats_aero
RUFFI_LOCAL_CREDENTIAL_FILE=.data/credentials.txt

# Local natural-language parser.
RUFFI_FLIGHT_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Jev preference ranking.
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Optional notification sender identities. Their credentials stay in the
# protected local credential file.
RUFFI_FROM_EMAIL=
TWILIO_FROM_NUMBER=
