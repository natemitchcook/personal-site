{
  "openapi": "3.0.3",
  "info": {
    "title": "Welvia",
    "version": "1.1.0",
    "description": "Business information and staff-reviewed requests. Invitation-scoped access is required for private business pages."
  },
  "servers": [
    {
      "url": "https://welvia.app"
    }
  ],
  "paths": {
    "/api/businesses/{businessId}": {
      "get": {
        "summary": "Read accessible business facts",
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved facts"
          },
          "404": {
            "description": "Unknown business"
          },
          "403": {
            "description": "Valid invitation for this business is required."
          }
        }
      }
    },
    "/api/businesses/{businessId}/requests": {
      "post": {
        "summary": "Submit a customer-approved catering inquiry",
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "submission_id",
                  "food",
                  "quantity",
                  "fulfillment",
                  "date",
                  "time",
                  "timezone",
                  "recipient",
                  "requester",
                  "phone",
                  "confirm"
                ],
                "properties": {
                  "submission_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "food": {
                    "type": "string",
                    "enum": [
                      "Bagel breakfast box",
                      "Sandwich lunch box"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 12,
                    "maximum": 500
                  },
                  "fulfillment": {
                    "type": "string",
                    "enum": [
                      "pickup",
                      "delivery"
                    ]
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "example": "10:30"
                  },
                  "timezone": {
                    "type": "string",
                    "enum": [
                      "America/Los_Angeles"
                    ]
                  },
                  "recipient": {
                    "type": "string"
                  },
                  "requester": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "zip": {
                    "type": "string"
                  },
                  "confirm": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Request received, not accepted"
          },
          "403": {
            "description": "Valid invitation for this business is required."
          },
          "422": {
            "description": "Missing fields or policy violation"
          },
          "200": {
            "description": "Original receipt returned for an identical retry"
          },
          "409": {
            "description": "Submission ID reused with different answers"
          },
          "429": {
            "description": "Rate limited; wait before retrying"
          },
          "503": {
            "description": "Database temporarily unavailable; retry with the same submission ID where applicable"
          }
        },
        "description": "Only test-kitchen is enabled. Customer approval is required. Full address, city, state and ZIP are required for delivery. Fictional ZIPs 92870/92886; at least 48 hours notice; arrival 8 AM to before 5 PM Pacific. Receipt means received, not accepted. Use made-up contact details."
      }
    },
    "/api/businesses/{businessId}/onboarding": {
      "post": {
        "summary": "Save owner answers for review; non-demo businesses require a private invitation",
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Answers saved"
          },
          "403": {
            "description": "Valid invitation for this business is required."
          },
          "422": {
            "description": "Missing or invalid answer"
          },
          "409": {
            "description": "Same submission ID with different answers"
          },
          "429": {
            "description": "Rate limited; wait before retrying"
          },
          "503": {
            "description": "Database temporarily unavailable; retry with the same submission ID where applicable"
          }
        },
        "security": [
          {},
          {
            "businessInvitation": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "submission_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "contact_name": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "contact_email": {
                    "type": "string",
                    "format": "email"
                  },
                  "services": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "request_route": {
                    "type": "string",
                    "enum": [
                      "email",
                      "phone",
                      "form"
                    ]
                  },
                  "request_destination": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "website_help": {
                    "type": "string",
                    "enum": [
                      "me",
                      "team",
                      "provider",
                      "unsure"
                    ]
                  },
                  "approval": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "lead_time": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "delivery_area": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "minimum": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "rules": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "submission_id",
                  "contact_name",
                  "contact_email",
                  "services",
                  "request_route",
                  "request_destination",
                  "website_help",
                  "approval"
                ]
              }
            }
          }
        },
        "description": "Anonymous submission is allowed only for test-kitchen. Every real business requires a valid business-scoped invitation. Save answers for review; this does not publish them or authorize implementation."
      }
    },
    "/api/businesses/{businessId}/qa": {
      "post": {
        "summary": "Answer a question using approved business FAQ facts",
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "question"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grounded answer or explicit unknown-detail fallback"
          },
          "429": {
            "description": "Rate limited; wait before retrying"
          },
          "503": {
            "description": "Database temporarily unavailable; retry with the same submission ID where applicable"
          },
          "403": {
            "description": "Valid invitation for this business is required."
          }
        }
      }
    },
    "/api/businesses/{businessId}/receipts": {
      "post": {
        "summary": "Read private receipt status with the capability returned to the submitter",
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,80}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receipt_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "receipt_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receipt status, reference and checklist; no submitted personal details"
          },
          "404": {
            "description": "Unknown receipt or wrong business"
          },
          "429": {
            "description": "Rate limited; wait before retrying"
          },
          "503": {
            "description": "Database temporarily unavailable; retry with the same submission ID where applicable"
          },
          "403": {
            "description": "Valid invitation for this business is required."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "businessInvitation": {
        "type": "http",
        "scheme": "bearer",
        "description": "Expiring invitation scoped to one business; issued by the owner through IAM-authorized administration."
      }
    }
  },
  "security": [
    {
      "businessInvitation": []
    }
  ]
}
